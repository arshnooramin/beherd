# Flask
SECRET_KEY=

# Database (defaults to SQLite at instance/beherd.db)
DATABASE_URL=

# "twilio" sends real texts; "console" prints texts and sign-in codes to the
# server log, for local development without a Twilio account.
MESSAGING_BACKEND=console

# Twilio (required when MESSAGING_BACKEND=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUM=
TWILIO_VERIFY_SID=

# Region for phone numbers typed without a country code
DEFAULT_REGION=US
